--- /dev/null
+++ b/services/vibratorservice/VibratorServiceName.cpp
@@ -0,0 +1,22 @@
+// Copyright (C) 2026 The LineageOS Project
+// SPDX-License-Identifier: Apache-2.0
+
+#include <aidl/android/hardware/vibrator/IVibrator.h>
+#include <android/binder_manager.h>
+#include <sys/system_properties.h>
+
+#include <vibratorservice/VibratorServiceName.h>
+
+namespace android::vibrator {
+
+std::string getVibratorServiceName() {
+    char device[PROP_VALUE_MAX] = {};
+    __system_property_get("ro.product.vendor.device", device);
+    return detail::
+            selectVibratorServiceName(aidl::android::hardware::vibrator::IVibrator::descriptor,
+                                      device, [](const std::string& name) {
+                                          return AServiceManager_isDeclared(name.c_str());
+                                      });
+}
+
+} // namespace android::vibrator
