diff --git a/services/vibratorservice/test/VibratorServiceNameTest.cpp b/services/vibratorservice/test/VibratorServiceNameTest.cpp
new file mode 100644
index 0000000..d41e5a5
--- /dev/null
+++ b/services/vibratorservice/test/VibratorServiceNameTest.cpp
@@ -0,0 +1,101 @@
+// Copyright (C) 2026 The LineageOS Project
+// SPDX-License-Identifier: Apache-2.0
+
+#include <gtest/gtest.h>
+#include <vibratorservice/VibratorServiceName.h>
+
+#include <vector>
+
+#ifdef __ANDROID__
+#include <android/binder_process.h>
+#include <sys/system_properties.h>
+#include <vibratorservice/VibratorManagerHalController.h>
+
+#include <thread>
+#endif
+
+namespace android::vibrator {
+namespace {
+
+const std::string kDescriptor = "android.hardware.vibrator.IVibrator";
+const std::string kDefault = kDescriptor + "/default";
+const std::string kStock = kDescriptor + "/vibratorfeature";
+
+TEST(VibratorServiceNameTest, StandardServiceTakesPriorityOnLapis) {
+    std::vector<std::string> queried;
+    auto name = detail::selectVibratorServiceName(kDescriptor, "lapis", [&](const auto& service) {
+        queried.push_back(service);
+        return true;
+    });
+    EXPECT_EQ(kDefault, name);
+    EXPECT_EQ(std::vector<std::string>({kDefault}), queried);
+}
+
+TEST(VibratorServiceNameTest, LapisUsesDeclaredStockServiceWithoutDefault) {
+    std::vector<std::string> queried;
+    auto name = detail::selectVibratorServiceName(kDescriptor, "lapis", [&](const auto& service) {
+        queried.push_back(service);
+        return service == kStock;
+    });
+    EXPECT_EQ(kStock, name);
+    EXPECT_EQ(std::vector<std::string>({kDefault, kStock}), queried);
+}
+
+TEST(VibratorServiceNameTest, OtherDevicesDoNotProbeXiaomiService) {
+    std::vector<std::string> queried;
+    auto name = detail::selectVibratorServiceName(kDescriptor, "other", [&](const auto& service) {
+        queried.push_back(service);
+        return service == kStock;
+    });
+    EXPECT_EQ(kDefault, name);
+    EXPECT_EQ(std::vector<std::string>({kDefault}), queried);
+}
+
+TEST(VibratorServiceNameTest, UndeclaredStockServiceIsNotSelected) {
+    auto name = detail::selectVibratorServiceName(kDescriptor, "lapis",
+                                                  [](const auto&) { return false; });
+    EXPECT_EQ(kDefault, name);
+}
+
+TEST(VibratorServiceNameTest, MissingDevicePropertyDoesNotEnableFallback) {
+    auto name = detail::selectVibratorServiceName(kDescriptor, "", [](const auto& service) {
+        return service == kStock;
+    });
+    EXPECT_EQ(kDefault, name);
+}
+
+#ifdef __ANDROID__
+// Explicit opt-in only: this test sends a single short pulse to real lapis hardware.
+TEST(VibratorServiceNameTest, DISABLED_LapisLiveServiceProbe) {
+    char device[PROP_VALUE_MAX] = {};
+    __system_property_get("ro.product.vendor.device", device);
+    if (std::string(device) != "lapis") {
+        GTEST_SKIP() << "Live probe is restricted to lapis";
+    }
+    ABinderProcess_setThreadPoolMaxThreadCount(1);
+    ABinderProcess_startThreadPool();
+    ASSERT_EQ(kStock, getVibratorServiceName());
+
+    ManagerHalController manager;
+    auto ids = manager.getVibratorIds();
+    ASSERT_TRUE(ids.isOk());
+    ASSERT_EQ(std::vector<int32_t>({0}), ids.value());
+    auto vibrator = manager.getVibrator(0);
+    ASSERT_TRUE(vibrator.isOk());
+    auto controller = vibrator.value();
+    ASSERT_NE(nullptr, controller);
+    ASSERT_TRUE(controller->getInfo().capabilities.isOk());
+
+    auto on = controller->doWithRetry<
+            void>([](HalWrapper* hal) { return hal->on(std::chrono::milliseconds(120), []() {}); },
+                  "lapis-live-probe-on");
+    std::this_thread::sleep_for(std::chrono::milliseconds(200));
+    auto off = controller->doWithRetry<void>([](HalWrapper* hal) { return hal->off(); },
+                                             "lapis-live-probe-off");
+    ASSERT_TRUE(on.isOk());
+    ASSERT_TRUE(off.isOk());
+}
+#endif
+
+} // namespace
+} // namespace android::vibrator
