diff --git a/services/vibratorservice/include/vibratorservice/VibratorServiceName.h b/services/vibratorservice/include/vibratorservice/VibratorServiceName.h
new file mode 100644
index 0000000..a8b9b9c
--- /dev/null
+++ b/services/vibratorservice/include/vibratorservice/VibratorServiceName.h
@@ -0,0 +1,32 @@
+// Copyright (C) 2026 The LineageOS Project
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <string>
+
+namespace android::vibrator {
+
+// Keep the same declared instance for discovery and reconnects.
+std::string getVibratorServiceName();
+
+namespace detail {
+
+template <typename IsDeclared>
+std::string selectVibratorServiceName(const std::string& descriptor, const std::string& device,
+                                      IsDeclared isDeclared) {
+    const auto defaultName = descriptor + "/default";
+    if (isDeclared(defaultName)) {
+        return defaultName;
+    }
+    if (device == "lapis") {
+        const auto stockName = descriptor + "/vibratorfeature";
+        if (isDeclared(stockName)) {
+            return stockName;
+        }
+    }
+    return defaultName;
+}
+
+} // namespace detail
+} // namespace android::vibrator
