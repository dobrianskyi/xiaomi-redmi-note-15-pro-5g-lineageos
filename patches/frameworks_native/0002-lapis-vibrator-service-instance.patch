index 302e3e1..dab09a9 100644
--- a/services/vibratorservice/VibratorHalController.cpp
+++ b/services/vibratorservice/VibratorHalController.cpp
@@ -24,6 +24,7 @@
 #include <vibratorservice/VibratorCallbackScheduler.h>
 #include <vibratorservice/VibratorHalController.h>
 #include <vibratorservice/VibratorHalWrapper.h>
+#include <vibratorservice/VibratorServiceName.h>
 
 using aidl::android::hardware::vibrator::CompositeEffect;
 using aidl::android::hardware::vibrator::CompositePrimitive;
@@ -46,13 +47,19 @@ std::shared_ptr<HalWrapper> connectHal(std::shared_ptr<CallbackScheduler> schedu
         return nullptr;
     }
 
-    auto serviceName = std::string(IVibrator::descriptor) + "/default";
+    auto serviceName = getVibratorServiceName();
     if (AServiceManager_isDeclared(serviceName.c_str())) {
         std::shared_ptr<IVibrator> hal = IVibrator::fromBinder(
                 ndk::SpAIBinder(AServiceManager_waitForService(serviceName.c_str())));
         if (hal) {
             ALOGV("Successfully connected to Vibrator HAL AIDL service.");
-            return std::make_shared<AidlHalWrapper>(std::move(scheduler), std::move(hal));
+            auto reconnect = [serviceName]() {
+                auto reconnected = IVibrator::fromBinder(
+                        ndk::SpAIBinder(AServiceManager_checkService(serviceName.c_str())));
+                return HalResult<std::shared_ptr<IVibrator>>::ok(std::move(reconnected));
+            };
+            return std::make_shared<AidlHalWrapper>(std::move(scheduler), std::move(hal),
+                                                    std::move(reconnect));
         }
     }
 
