From 3f553a27ddc998faa725e2a33292835875694058 Mon Sep 17 00:00:00 2001
From: Lapis bring-up <lapis@localhost>
Date: Thu, 5 Nov 2026 20:23:14 +0200
Subject: [PATCH] launcher: make workspace notification swipe optional

---
 .../touchcontrollers/StatusBarTouchController.java         | 4 ++++
 res/values/lineage_strings.xml                             | 2 ++
 res/xml/launcher_preferences.xml                           | 7 +++++++
 src/com/android/launcher3/LauncherPrefs.kt                 | 1 +
 4 files changed, 14 insertions(+)

diff --git a/quickstep/src/com/android/launcher3/uioverrides/touchcontrollers/StatusBarTouchController.java b/quickstep/src/com/android/launcher3/uioverrides/touchcontrollers/StatusBarTouchController.java
index f69865e..2cbf20c 100644
--- a/quickstep/src/com/android/launcher3/uioverrides/touchcontrollers/StatusBarTouchController.java
+++ b/quickstep/src/com/android/launcher3/uioverrides/touchcontrollers/StatusBarTouchController.java
@@ -31,6 +31,7 @@ import android.view.ViewConfiguration;
 
 import com.android.launcher3.AbstractFloatingView;
 import com.android.launcher3.BaseActivity;
+import com.android.launcher3.LauncherPrefs;
 import com.android.launcher3.DeviceProfile;
 import com.android.launcher3.util.TouchController;
 import com.android.quickstep.SystemUiProxy;
@@ -137,6 +138,9 @@ public class StatusBarTouchController implements TouchController {
     }
 
     private boolean canInterceptTouch(MotionEvent ev) {
+        if (!LauncherPrefs.SWIPE_DOWN_NOTIFICATIONS.get(mLauncher.asContext())) {
+            return false;
+        }
         if (isTrackpadMultiFingerSwipe(ev)) {
             // Trackpad events are handled separately, see e.g. TrackpadStatusBarInputConsumer.
             return false;
diff --git a/res/values/lineage_strings.xml b/res/values/lineage_strings.xml
index f223b4c..38ba0ef 100644
--- a/res/values/lineage_strings.xml
+++ b/res/values/lineage_strings.xml
@@ -77,4 +77,6 @@
     <string name="trust_apps_help">Help</string>
     <string name="trust_apps_info_hidden">Hidden apps and their widgets are hidden from the drawer</string>
     <string name="trust_apps_info_protected">Protected apps require authentication to be opened from the launcher</string>
+    <string name="pref_swipe_down_notifications_title">Swipe down for notifications</string>
+    <string name="pref_swipe_down_notifications_summary">Open notifications by swiping down anywhere on the home screen</string>
 </resources>
diff --git a/res/xml/launcher_preferences.xml b/res/xml/launcher_preferences.xml
index 3ef7795..1c8de20 100644
--- a/res/xml/launcher_preferences.xml
+++ b/res/xml/launcher_preferences.xml
@@ -33,6 +33,13 @@
         android:title="@string/pref_sleep_gesture_title"
         android:summary="@string/pref_sleep_gesture_summary" />
 
+    <SwitchPreferenceCompat
+        android:defaultValue="false"
+        android:key="pref_swipe_down_notifications"
+        android:persistent="true"
+        android:title="@string/pref_swipe_down_notifications_title"
+        android:summary="@string/pref_swipe_down_notifications_summary" />
+
     <com.android.launcher3.settings.NotificationDotsPreference
         android:key="pref_icon_badging"
         android:title="@string/notification_dots_title"
diff --git a/src/com/android/launcher3/LauncherPrefs.kt b/src/com/android/launcher3/LauncherPrefs.kt
index c624c35..d8f8efa 100644
--- a/src/com/android/launcher3/LauncherPrefs.kt
+++ b/src/com/android/launcher3/LauncherPrefs.kt
@@ -266,6 +266,7 @@ constructor(@ApplicationContext private val encryptedContext: Context) {
         @JvmField val SHOW_DESKTOP_LABELS = backedUpItem("pref_desktop_show_labels", true)
         @JvmField val SHOW_DRAWER_LABELS = backedUpItem("pref_drawer_show_labels", true)
         @JvmField val SLEEP_GESTURE = backedUpItem("pref_sleep_gesture", false)
+        @JvmField val SWIPE_DOWN_NOTIFICATIONS = backedUpItem("pref_swipe_down_notifications", false)
         @JvmField val WORKSPACE_LOCK = backedUpItem("pref_workspace_lock", false)
         @JvmField
         val PROMISE_ICON_IDS = nonRestorableItem(InstallSessionHelper.PROMISE_ICON_IDS, "")
-- 
2.56.0

