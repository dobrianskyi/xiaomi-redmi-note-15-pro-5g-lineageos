---
 .../server/vibrator/VibratorServiceName.java  | 21 +++++++++
 .../server/vibrator/VintfHalVibrator.java     | 13 +++++-
 .../vibrator/VintfHalVibratorManager.java     | 11 +++--
 .../vibrator/VibratorServiceNameTest.java     | 45 +++++++++++++++++++
 4 files changed, 84 insertions(+), 6 deletions(-)
 create mode 100644 services/core/java/com/android/server/vibrator/VibratorServiceName.java
 create mode 100644 services/tests/vibrator/src/com/android/server/vibrator/VibratorServiceNameTest.java

diff --git a/services/core/java/com/android/server/vibrator/VibratorServiceName.java b/services/core/java/com/android/server/vibrator/VibratorServiceName.java
new file mode 100644
index 000000000..cad7d62da
--- /dev/null
+++ b/services/core/java/com/android/server/vibrator/VibratorServiceName.java
@@ -0,0 +1,21 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.vibrator;
+
+import java.util.function.Predicate;
+
+/** The same instance selection policy used by the native vibrator clients. */
+final class VibratorServiceName {
+    private VibratorServiceName() {}
+
+    static String select(String descriptor, String device, Predicate<String> isDeclared) {
+        String standard = descriptor + "/default";
+        if (isDeclared.test(standard)) {
+            return standard;
+        }
+        String stock = descriptor + "/vibratorfeature";
+        return "lapis".equals(device) && isDeclared.test(stock) ? stock : null;
+    }
+}
diff --git a/services/core/java/com/android/server/vibrator/VintfHalVibrator.java b/services/core/java/com/android/server/vibrator/VintfHalVibrator.java
index a8d922415..4e6568a3f 100644
--- a/services/core/java/com/android/server/vibrator/VintfHalVibrator.java
+++ b/services/core/java/com/android/server/vibrator/VintfHalVibrator.java
@@ -97,11 +97,20 @@ class VintfHalVibrator {
 
     /** {@link VintfSupplier} for default {@link IVibrator} service. */
     static final class DefaultVibratorSupplier extends VintfSupplier<IVibrator> {
+        private final String mServiceName;
+
+        DefaultVibratorSupplier() {
+            this(IVibrator.DESCRIPTOR + "/default");
+        }
+
+        DefaultVibratorSupplier(String serviceName) {
+            mServiceName = serviceName;
+        }
+
         @Nullable
         @Override
         IBinder connectToService() {
-            return Binder.allowBlocking(ServiceManager.waitForDeclaredService(
-                    IVibrator.DESCRIPTOR + "/default"));
+            return Binder.allowBlocking(ServiceManager.waitForDeclaredService(mServiceName));
         }
 
         @NonNull
diff --git a/services/core/java/com/android/server/vibrator/VintfHalVibratorManager.java b/services/core/java/com/android/server/vibrator/VintfHalVibratorManager.java
index 6350d05e4..7ca9ede25 100644
--- a/services/core/java/com/android/server/vibrator/VintfHalVibratorManager.java
+++ b/services/core/java/com/android/server/vibrator/VintfHalVibratorManager.java
@@ -29,6 +29,7 @@ import android.os.Handler;
 import android.os.IBinder;
 import android.os.RemoteException;
 import android.os.ServiceManager;
+import android.os.SystemProperties;
 import android.os.vibrator.IHapticChannelStream;
 import android.util.IndentingPrintWriter;
 import android.util.LongSparseArray;
@@ -63,14 +64,16 @@ class VintfHalVibratorManager {
                             nativeHandler);
             return new DefaultHalVibratorManager(managerSupplier, nativeHandler, vibratorFactory);
         }
-        if (ServiceManager.isDeclared(IVibrator.DESCRIPTOR + "/default")) {
-            Slog.v(TAG, "Loading default IVibrator service.");
+        String serviceName = VibratorServiceName.select(IVibrator.DESCRIPTOR,
+                SystemProperties.get("ro.product.vendor.device"), ServiceManager::isDeclared);
+        if (serviceName != null) {
+            Slog.v(TAG, "Loading IVibrator service " + serviceName);
             return new LegacyHalVibratorManager(
-                    new DefaultHalVibrator(DEFAULT_VIBRATOR_ID, new DefaultVibratorSupplier(),
+                    new DefaultHalVibrator(DEFAULT_VIBRATOR_ID, new DefaultVibratorSupplier(serviceName),
                             handler, nativeHandler),
                     nativeHandler);
         }
-        Slog.v(TAG, "No default services declared for IVibratorManager or IVibrator."
+        Slog.v(TAG, "No supported services declared for IVibratorManager or IVibrator."
                 + " Vibrator manager service will proceed without vibrator hardware.");
         return new LegacyHalVibratorManager();
     }
diff --git a/services/tests/vibrator/src/com/android/server/vibrator/VibratorServiceNameTest.java b/services/tests/vibrator/src/com/android/server/vibrator/VibratorServiceNameTest.java
new file mode 100644
index 000000000..7fb92955e
--- /dev/null
+++ b/services/tests/vibrator/src/com/android/server/vibrator/VibratorServiceNameTest.java
@@ -0,0 +1,45 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.vibrator;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.fail;
+
+import org.junit.Test;
+
+public class VibratorServiceNameTest {
+    private static final String DESCRIPTOR = "android.hardware.vibrator.IVibrator";
+    private static final String DEFAULT = DESCRIPTOR + "/default";
+    private static final String STOCK = DESCRIPTOR + "/vibratorfeature";
+
+    @Test
+    public void declaredDefaultTakesPriority() {
+        assertEquals(DEFAULT, VibratorServiceName.select(DESCRIPTOR, "lapis", service -> true));
+    }
+
+    @Test
+    public void lapisUsesDeclaredStockInstance() {
+        assertEquals(STOCK, VibratorServiceName.select(DESCRIPTOR, "lapis", STOCK::equals));
+    }
+
+    @Test
+    public void otherDevicesNeverProbeStockInstance() {
+        assertNull(VibratorServiceName.select(DESCRIPTOR, "other", service -> {
+            if (!DEFAULT.equals(service)) fail("Probed lapis service on another device");
+            return false;
+        }));
+    }
+
+    @Test
+    public void undeclaredServiceIsNotSelected() {
+        assertNull(VibratorServiceName.select(DESCRIPTOR, "lapis", service -> false));
+    }
+
+    @Test
+    public void missingDeviceDoesNotEnableFallback() {
+        assertNull(VibratorServiceName.select(DESCRIPTOR, "", STOCK::equals));
+    }
+}
