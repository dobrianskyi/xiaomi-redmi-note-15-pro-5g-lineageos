From 6c70cf069db0beb864ffea2eb7cc7d8b51e11fd7 Mon Sep 17 00:00:00 2001
From: Oleksii Dobrianskyi <dobriansky777@gmail.com>
Date: Fri, 6 Nov 2026 19:48:26 +0200
Subject: [PATCH] Lockscreen: allow opt-in auto-confirm for four-digit PINs

Change-Id: I7c506afb93c1568b074eab44fc2233cad177d809
---
 .../internal/widget/LockPatternUtils.java     |  2 +-
 .../LockSettingsStorageTestable.java          |  8 +++++++-
 .../locksettings/SyntheticPasswordTests.java  | 19 +++++++++++++++++--
 3 files changed, 25 insertions(+), 4 deletions(-)

diff --git a/core/java/com/android/internal/widget/LockPatternUtils.java b/core/java/com/android/internal/widget/LockPatternUtils.java
index d2003753e..28b09111e 100644
--- a/core/java/com/android/internal/widget/LockPatternUtils.java
+++ b/core/java/com/android/internal/widget/LockPatternUtils.java
@@ -134,7 +134,7 @@ public class LockPatternUtils {
     public static final int PIN_LENGTH_UNAVAILABLE = -1;
 
     // This is the minimum pin length at which auto confirmation is supported
-    public static final int MIN_AUTO_PIN_REQUIREMENT_LENGTH = 6;
+    public static final int MIN_AUTO_PIN_REQUIREMENT_LENGTH = 4;
 
     /**
      * Header used for the encryption and decryption of the device credential for
diff --git a/services/tests/servicestests/src/com/android/server/locksettings/LockSettingsStorageTestable.java b/services/tests/servicestests/src/com/android/server/locksettings/LockSettingsStorageTestable.java
index c01d0f644..33f849fe6 100644
--- a/services/tests/servicestests/src/com/android/server/locksettings/LockSettingsStorageTestable.java
+++ b/services/tests/servicestests/src/com/android/server/locksettings/LockSettingsStorageTestable.java
@@ -97,9 +97,15 @@ public class LockSettingsStorageTestable extends LockSettingsStorage {
     PersistentDataBlockManagerInternal getPersistentDataBlockManager() {
         return mPersistentDataBlockManager;
     }
+    private boolean mAutoPinConfirmEnabled = true;
+
+    void setAutoPinConfirmSettingEnabled(boolean enabled) {
+        mAutoPinConfirmEnabled = enabled;
+    }
+
     @Override
     public boolean isAutoPinConfirmSettingEnabled(int userId) {
-        return true;
+        return mAutoPinConfirmEnabled;
     }
     private File remapToStorageDir(File origPath) {
         File mappedPath = new File(mStorageDir, origPath.toString());
diff --git a/services/tests/servicestests/src/com/android/server/locksettings/SyntheticPasswordTests.java b/services/tests/servicestests/src/com/android/server/locksettings/SyntheticPasswordTests.java
index 4cf1b9798..4a8f76ee9 100644
--- a/services/tests/servicestests/src/com/android/server/locksettings/SyntheticPasswordTests.java
+++ b/services/tests/servicestests/src/com/android/server/locksettings/SyntheticPasswordTests.java
@@ -697,8 +697,23 @@ public class SyntheticPasswordTests extends BaseLockSettingsServiceTests {
 
     @Test
     public void testStorePinLengthOnDisk() {
+        assertStoredPinLength("123456", true, 6);
+    }
+
+    @Test
+    public void testStoreFourDigitPinLengthOnDisk() {
+        assertStoredPinLength("1234", true, 4);
+    }
+
+    @Test
+    public void testFourDigitPinLengthUnavailableWithoutAutoConfirm() {
+        assertStoredPinLength("1234", false, PIN_LENGTH_UNAVAILABLE);
+    }
+
+    private void assertStoredPinLength(String pin, boolean autoConfirm, int expectedLength) {
         int userId = 1;
-        LockscreenCredential lockscreenCredentialPin = LockscreenCredential.createPin("123456");
+        LockscreenCredential lockscreenCredentialPin = LockscreenCredential.createPin(pin);
+        mStorage.setAutoPinConfirmSettingEnabled(autoConfirm);
         MockSyntheticPasswordManager manager =
                 new MockSyntheticPasswordManager(
                         mContext,
@@ -714,7 +729,7 @@ public class SyntheticPasswordTests extends BaseLockSettingsServiceTests {
                 PasswordMetrics.computeForCredential(lockscreenCredentialPin);
         boolean result = manager.refreshPinLengthOnDisk(passwordMetrics, protectorId, userId);
 
-        assertEquals(manager.getPinLength(protectorId, userId), lockscreenCredentialPin.size());
+        assertEquals(expectedLength, manager.getPinLength(protectorId, userId));
         assertTrue(result);
     }
 
-- 
2.56.0

