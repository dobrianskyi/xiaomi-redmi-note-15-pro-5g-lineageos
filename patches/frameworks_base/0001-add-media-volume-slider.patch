+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.systemui.qs;
+
+import android.app.ActivityManager;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.media.AudioManager;
+import android.os.UserHandle;
+import android.os.UserManager;
+import android.widget.LinearLayout;
+import android.widget.SeekBar;
+import android.widget.TextView;
+
+import com.android.systemui.res.R;
+
+/** Media-only volume control shared by the View and Compose quick settings panels. */
+public class MediaVolumeSliderView extends LinearLayout {
+    private final AudioManager mAudioManager;
+    private final SeekBar mSlider;
+    private boolean mTracking;
+    private final BroadcastReceiver mReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            refresh();
+        }
+    };
+
+    public MediaVolumeSliderView(Context context) {
+        super(context);
+        mAudioManager = context.getSystemService(AudioManager.class);
+        setOrientation(VERTICAL);
+        TextView label = new TextView(context);
+        label.setText(R.string.qs_media_volume_label);
+        label.setTextAppearance(android.R.style.TextAppearance_Material_Small);
+        android.content.res.TypedArray colors = context.obtainStyledAttributes(
+                new int[] {R.attr.onShadeInactive});
+        label.setTextColor(colors.getColor(0, android.graphics.Color.WHITE));
+        colors.recycle();
+        int inset = getResources().getDimensionPixelSize(R.dimen.rounded_slider_icon_inset);
+        label.setPaddingRelative(inset, 0, inset, 0);
+        addView(label);
+        mSlider = new SeekBar(context);
+        mSlider.setContentDescription(context.getString(R.string.qs_media_volume_label));
+        mSlider.setThumb(null);
+        mSlider.setTickMark(null);
+        mSlider.setSplitTrack(false);
+        mSlider.setProgressTintList(null);
+        mSlider.setProgressBackgroundTintList(null);
+        mSlider.setPadding(0, 0, 0, 0);
+        mSlider.setProgressDrawable(context.getDrawable(R.drawable.media_volume_progress_drawable));
+        addView(mSlider, new LayoutParams(LayoutParams.MATCH_PARENT,
+                getResources().getDimensionPixelSize(R.dimen.brightness_mirror_height)));
+        mSlider.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            @Override
+            public void onProgressChanged(SeekBar seekBar, int progress, boolean fromUser) {
+                if (fromUser && seekBar.isEnabled()) {
+                    mAudioManager.setStreamVolume(AudioManager.STREAM_MUSIC, progress,
+                            AudioManager.FLAG_SHOW_UI_WARNINGS);
+                    if (!mTracking) refresh();
+                }
+            }
+
+            @Override
+            public void onStartTrackingTouch(SeekBar seekBar) {
+                mTracking = true;
+                getParent().requestDisallowInterceptTouchEvent(true);
+            }
+
+            @Override
+            public void onStopTrackingTouch(SeekBar seekBar) {
+                mTracking = false;
+                getParent().requestDisallowInterceptTouchEvent(false);
+                refresh();
+            }
+        });
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        IntentFilter filter = new IntentFilter(AudioManager.VOLUME_CHANGED_ACTION);
+        filter.addAction(AudioManager.STREAM_DEVICES_CHANGED_ACTION);
+        filter.addAction(AudioManager.STREAM_MUTE_CHANGED_ACTION);
+        filter.addAction(Intent.ACTION_USER_SWITCHED);
+        filter.addAction(UserManager.ACTION_USER_RESTRICTIONS_CHANGED);
+        getContext().registerReceiverAsUser(mReceiver, UserHandle.ALL, filter, null, null,
+                Context.RECEIVER_EXPORTED);
+        refresh();
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        getContext().unregisterReceiver(mReceiver);
+        mTracking = false;
+        super.onDetachedFromWindow();
+    }
+
+    private void refresh() {
+        boolean restricted = getContext().getSystemService(UserManager.class).hasUserRestriction(
+                UserManager.DISALLOW_ADJUST_VOLUME, UserHandle.of(ActivityManager.getCurrentUser()));
+        mSlider.setEnabled(!mAudioManager.isVolumeFixed() && !restricted);
+        mSlider.setMin(mAudioManager.getStreamMinVolume(AudioManager.STREAM_MUSIC));
+        mSlider.setMax(mAudioManager.getStreamMaxVolume(AudioManager.STREAM_MUSIC));
+        if (!mTracking) {
+            mSlider.setProgress(mAudioManager.getStreamVolume(AudioManager.STREAM_MUSIC));
+        }
+    }
+}
