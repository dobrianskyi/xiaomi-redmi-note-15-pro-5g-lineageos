From: Lapis Bringup <lapis@localhost>
Subject: [PATCH] SystemUI: allow devices to require top-edge lockscreen shade gestures

Latch the gesture origin before lockscreen drag interception. Keep upward
unlock gestures and the existing QS status-bar path unchanged. Default off
for other devices; Lapis opts in through its SystemUI overlay.

diff --git a/packages/SystemUI/res/values/config.xml b/packages/SystemUI/res/values/config.xml
index e0bc1ec0e..6b179c4d1 100644
--- a/packages/SystemUI/res/values/config.xml
+++ b/packages/SystemUI/res/values/config.xml
@@ -1186,4 +1186,6 @@
 
     <!-- Indicates whether the tapping to open qs panel is supported -->
     <bool name="config_statusBarTapToExpandShade">false</bool>
+    <!-- Require a top-edge gesture to open the shade from the lockscreen. -->
+    <bool name="config_lockscreenShadeRequiresTopEdge">false</bool>
 </resources>
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/LockscreenShadeTransitionController.kt b/packages/SystemUI/src/com/android/systemui/statusbar/LockscreenShadeTransitionController.kt
index 864bb7084..a4b37c628 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/LockscreenShadeTransitionController.kt
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/LockscreenShadeTransitionController.kt
@@ -12,6 +12,7 @@ import android.view.View
 import android.view.ViewConfiguration
 import androidx.annotation.FloatRange
 import androidx.annotation.VisibleForTesting
+import com.android.internal.policy.SystemBarUtils
 import com.android.systemui.Dumpable
 import com.android.systemui.ExpandHelper
 import com.android.systemui.Gefingerpoken
@@ -762,6 +763,9 @@ class DragDownHelper(
     private var dragDownAmountOnStart = 0.0f
     lateinit var expandCallback: ExpandHelper.Callback
 
+    private var requireTopEdgeOnKeyguard = false
+    private var statusBarHeight = 0
+    private var blockedOutsideTopEdge = false
     private var minDragDistance = 0
     private var initialTouchX = 0f
     private var initialTouchY = 0f
@@ -790,6 +794,9 @@ class DragDownHelper(
     }
 
     fun updateResources(context: Context) {
+        requireTopEdgeOnKeyguard =
+            context.resources.getBoolean(R.bool.config_lockscreenShadeRequiresTopEdge)
+        statusBarHeight = SystemBarUtils.getStatusBarHeight(context)
         minDragDistance =
             context.resources.getDimensionPixelSize(R.dimen.keyguard_drag_down_min_distance)
         val configuration = ViewConfiguration.get(context)
@@ -802,6 +809,9 @@ class DragDownHelper(
         val y = event.y
         when (event.actionMasked) {
             MotionEvent.ACTION_DOWN -> {
+                // Latch the origin: crossing into the status bar later must not start a drag.
+                blockedOutsideTopEdge = requireTopEdgeOnKeyguard &&
+                    dragDownCallback.isFalsingCheckNeeded && event.rawY > statusBarHeight
                 draggedFarEnough = false
                 isDraggingDown = false
                 startingChild = null
@@ -810,6 +820,7 @@ class DragDownHelper(
             }
 
             MotionEvent.ACTION_MOVE -> {
+                if (blockedOutsideTopEdge) return false
                 val h = y - initialTouchY
                 // Adjust the touch slop if another gesture may be being performed.
                 val touchSlop =
