diff --git a/services/core/java/com/android/server/biometrics/sensors/LapisFingerprintExtension.java b/services/core/java/com/android/server/biometrics/sensors/LapisFingerprintExtension.java
new file mode 100644
index 000000000..563542a43
--- /dev/null
+++ b/services/core/java/com/android/server/biometrics/sensors/LapisFingerprintExtension.java
@@ -0,0 +1,161 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server.biometrics.sensors;
+
+import android.content.Context;
+import android.hardware.biometrics.BiometricRequestConstants;
+import android.hardware.display.DisplayManager;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.IBinder;
+import android.os.IServiceCallback;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.os.SystemProperties;
+import android.util.Slog;
+import android.view.Display;
+
+import vendor.xiaomi.hardware.fingerprintextension.IXiaomiFingerprint;
+
+/** Supplies the lapis FodEngine states from the framework operation lifecycle. */
+final class LapisFingerprintExtension {
+    private static final String TAG = "LapisFingerprint";
+    private static final String SERVICE = IXiaomiFingerprint.DESCRIPTOR + "/default";
+    private static LapisFingerprintExtension sInstance;
+    private final Handler mHandler;
+    private final DisplayManager mDisplays;
+    // All mutable state below is confined to mHandler.
+    private Object mOwner;
+    private int mOperation = 2;
+    private int mPower = -1;
+    private IXiaomiFingerprint mVendor;
+
+    static synchronized LapisFingerprintExtension get(Context context, int sensorId) {
+        if (sensorId != 5
+                || !"lapis".equals(SystemProperties.get("ro.product.vendor.device"))) {
+            return null;
+        }
+        if (sInstance == null) {
+            sInstance = new LapisFingerprintExtension(context);
+        }
+        return sInstance;
+    }
+
+    private LapisFingerprintExtension(Context context) {
+        HandlerThread thread = new HandlerThread(TAG);
+        thread.start();
+        mHandler = new Handler(thread.getLooper());
+        mDisplays = context.getSystemService(DisplayManager.class);
+        mDisplays.registerDisplayListener(new DisplayManager.DisplayListener() {
+            @Override public void onDisplayAdded(int id) { changed(id); }
+            @Override public void onDisplayRemoved(int id) { changed(id); }
+            @Override public void onDisplayChanged(int id) { changed(id); }
+            private void changed(int id) {
+                if (id == Display.DEFAULT_DISPLAY && power() != mPower) {
+                    apply();
+                }
+            }
+        }, mHandler);
+        mHandler.post(() -> {
+            try {
+                ServiceManager.registerForNotifications(SERVICE, new IServiceCallback.Stub() {
+                    @Override public void onRegistration(String name, IBinder binder) {
+                        mHandler.post(() -> connect(binder));
+                    }
+                });
+            } catch (RemoteException | RuntimeException e) {
+                Slog.e(TAG, "Cannot observe fingerprint extension registration", e);
+            }
+            connect(ServiceManager.checkService(SERVICE));
+        });
+    }
+
+    void show(Object owner, int reason) {
+        int operation;
+        switch (reason) {
+            case BiometricRequestConstants.REASON_ENROLL_FIND_SENSOR:
+            case BiometricRequestConstants.REASON_ENROLL_ENROLLING:
+                operation = 1;
+                break;
+            case BiometricRequestConstants.REASON_AUTH_BP:
+            case BiometricRequestConstants.REASON_AUTH_KEYGUARD:
+            case BiometricRequestConstants.REASON_AUTH_OTHER:
+            case BiometricRequestConstants.REASON_AUTH_SETTINGS:
+                operation = 3;
+                break;
+            default:
+                return;
+        }
+        mHandler.post(() -> {
+            mOwner = owner;
+            mOperation = operation;
+            if (mVendor == null) {
+                connect(ServiceManager.checkService(SERVICE));
+            } else {
+                apply();
+            }
+        });
+    }
+
+    void hide(Object owner) {
+        mHandler.post(() -> {
+            // A late completion from an old client must not stop its successor.
+            if (mOwner == owner) {
+                mOwner = null;
+                mOperation = 2;
+                apply();
+            }
+        });
+    }
+
+    private int power() {
+        Display display = mDisplays.getDisplay(Display.DEFAULT_DISPLAY);
+        int state = display == null ? Display.STATE_OFF : display.getState();
+        if (state == Display.STATE_ON || state == Display.STATE_ON_SUSPEND) return 2;
+        if (state == Display.STATE_DOZE || state == Display.STATE_DOZE_SUSPEND) return 1;
+        return 0;
+    }
+
+    private void connect(IBinder binder) {
+        if (binder == null || (mVendor != null && mVendor.asBinder() == binder)) return;
+        try {
+            IXiaomiFingerprint vendor = IXiaomiFingerprint.Stub.asInterface(binder);
+            if (vendor.getInterfaceVersion() < 1) return;
+            binder.linkToDeath(() -> mHandler.post(() -> {
+                if (mVendor != null && mVendor.asBinder() == binder) {
+                    mVendor = null;
+                }
+            }), 0);
+            mVendor = vendor;
+            // Replay the current operation when the vendor process restarts.
+            apply();
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(TAG, "Cannot connect to fingerprint extension", e);
+        }
+    }
+
+    private void command(int command, int value) throws RemoteException {
+        int result = mVendor.extCmd(command, value);
+        if (result < 0) {
+            Slog.w(TAG, "Fingerprint extension command " + command + " failed: " + result);
+        }
+    }
+
+    private void apply() {
+        mPower = power();
+        if (mVendor == null) return;
+        try {
+            if (mOwner == null) {
+                command(1, 0); // Animation absent.
+                command(4, 2); // Fingerprint operation idle.
+            } else {
+                command(2, 0); // No stock color-fade animation.
+                command(3, mPower);
+                command(4, mOperation);
+                command(1, 1); // UDFPS overlay present.
+            }
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(TAG, "Fingerprint extension update failed", e);
+            mVendor = null;
+        }
+    }
+}
