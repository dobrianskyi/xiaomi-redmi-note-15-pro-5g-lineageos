     @Override
@@ -102,10 +123,34 @@ public class MediaVolumeSliderView extends LinearLayout {
         super.onDetachedFromWindow();
     }
 
-    private void refresh() {
+    private boolean canAdjustVolume() {
         boolean restricted = getContext().getSystemService(UserManager.class).hasUserRestriction(
                 UserManager.DISALLOW_ADJUST_VOLUME, UserHandle.of(ActivityManager.getCurrentUser()));
-        mSlider.setEnabled(!mAudioManager.isVolumeFixed() && !restricted);
+        return !mAudioManager.isVolumeFixed() && !restricted;
+    }
+
+    private void toggleMute() {
+        if (canAdjustVolume()) {
+            // AudioService keeps the current route's volume index while muting, so unmute
+            // restores it without a view-local cache or overwriting the slider level with zero.
+            mAudioManager.adjustStreamVolume(AudioManager.STREAM_MUSIC,
+                    AudioManager.ADJUST_TOGGLE_MUTE, AudioManager.FLAG_SHOW_UI_WARNINGS);
+        }
+        refresh();
+    }
+
+    private void refresh() {
+        boolean adjustable = canAdjustVolume();
+        boolean muted = mAudioManager.isStreamMute(AudioManager.STREAM_MUSIC);
+        mSlider.setEnabled(adjustable);
+        mMuteButton.setEnabled(adjustable);
+        mMuteButton.setAlpha(adjustable ? 1f : 0.38f);
+        mMuteButton.setSelected(!muted);
+        mMuteButton.setImageResource(muted ? R.drawable.ic_speaker_mute : R.drawable.ic_speaker_on);
+        String description = getContext().getString(muted ? R.string.volume_panel_hint_unmute
+                : R.string.volume_panel_hint_mute, getContext().getString(R.string.stream_music));
+        mMuteButton.setContentDescription(description);
+        mMuteButton.setTooltipText(description);
         mSlider.setMin(mAudioManager.getStreamMinVolume(AudioManager.STREAM_MUSIC));
         mSlider.setMax(mAudioManager.getStreamMaxVolume(AudioManager.STREAM_MUSIC));
         if (!mTracking) {
diff --git a/packages/SystemUI/tests/src/com/android/systemui/qs/MediaVolumeSliderViewTest.java b/packages/SystemUI/tests/src/com/android/systemui/qs/MediaVolumeSliderViewTest.java
new file mode 100644
