--- /dev/null
+++ b/packages/SystemUI/tests/src/com/android/systemui/qs/MediaVolumeSliderViewTest.java
@@ -0,0 +1,118 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.systemui.qs;
+
+import static com.google.common.truth.Truth.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyInt;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.doAnswer;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.times;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import android.media.AudioManager;
+import android.os.UserHandle;
+import android.os.UserManager;
+import android.testing.AndroidTestingRunner;
+import android.testing.TestableLooper;
+import android.widget.ImageButton;
+import android.widget.SeekBar;
+
+import androidx.test.filters.SmallTest;
+
+import com.android.systemui.SysuiTestCase;
+import com.android.systemui.res.R;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+@SmallTest
+@RunWith(AndroidTestingRunner.class)
+@TestableLooper.RunWithLooper
+public class MediaVolumeSliderViewTest extends SysuiTestCase {
+    private final AudioManager mAudioManager = mock(AudioManager.class);
+    private final UserManager mUserManager = mock(UserManager.class);
+    private int mVolume = 7;
+    private boolean mMuted;
+
+    @Before
+    public void setUp() {
+        mContext.addMockSystemService(AudioManager.class, mAudioManager);
+        mContext.addMockSystemService(UserManager.class, mUserManager);
+        when(mAudioManager.getStreamMaxVolume(AudioManager.STREAM_MUSIC)).thenReturn(15);
+        when(mAudioManager.getStreamVolume(AudioManager.STREAM_MUSIC))
+                .thenAnswer(invocation -> mMuted ? 0 : mVolume);
+        when(mAudioManager.isStreamMute(AudioManager.STREAM_MUSIC))
+                .thenAnswer(invocation -> mMuted);
+        doAnswer(invocation -> {
+            mMuted = !mMuted;
+            return null;
+        }).when(mAudioManager).adjustStreamVolume(AudioManager.STREAM_MUSIC,
+                AudioManager.ADJUST_TOGGLE_MUTE, AudioManager.FLAG_SHOW_UI_WARNINGS);
+    }
+
+    @Test
+    public void muteAndRecreateView_unmuteUsesServiceLevelWithoutWritingZero() {
+        MediaVolumeSliderView view = new MediaVolumeSliderView(mContext);
+        ImageButton button = view.findViewById(R.id.qs_media_volume_mute);
+        assertThat(button.isSelected()).isTrue();
+        button.performClick();
+        assertThat(mMuted).isTrue();
+        SeekBar slider = view.findViewById(R.id.qs_media_volume_slider);
+        assertThat(slider.getProgress()).isEqualTo(0);
+        assertThat(button.isSelected()).isFalse();
+
+        MediaVolumeSliderView recreated = new MediaVolumeSliderView(mContext);
+        ImageButton recreatedButton = recreated.findViewById(R.id.qs_media_volume_mute);
+        assertThat(recreatedButton.getContentDescription().toString()).isEqualTo(
+                mContext.getString(R.string.volume_panel_hint_unmute,
+                        mContext.getString(R.string.stream_music)));
+        recreatedButton.performClick();
+        SeekBar recreatedSlider = recreated.findViewById(R.id.qs_media_volume_slider);
+        assertThat(recreatedSlider.getProgress()).isEqualTo(7);
+        assertThat(mMuted).isFalse();
+        verify(mAudioManager, times(2)).adjustStreamVolume(AudioManager.STREAM_MUSIC,
+                AudioManager.ADJUST_TOGGLE_MUTE, AudioManager.FLAG_SHOW_UI_WARNINGS);
+        verify(mAudioManager, never()).setStreamVolume(anyInt(), anyInt(), anyInt());
+    }
+
+    @Test
+    public void recreateWithChangedServiceLevel_doesNotRestoreAStaleCachedVolume() {
+        new MediaVolumeSliderView(mContext).findViewById(R.id.qs_media_volume_mute)
+                .performClick();
+        mVolume = 11;
+        MediaVolumeSliderView recreated = new MediaVolumeSliderView(mContext);
+        recreated.findViewById(R.id.qs_media_volume_mute).performClick();
+        SeekBar slider = recreated.findViewById(R.id.qs_media_volume_slider);
+        assertThat(slider.getProgress()).isEqualTo(11);
+        verify(mAudioManager, never()).setStreamVolume(anyInt(), anyInt(), anyInt());
+    }
+
+    @Test
+    public void fixedVolume_disablesBothControlsAndDoesNotAdjustAudio() {
+        when(mAudioManager.isVolumeFixed()).thenReturn(true);
+        MediaVolumeSliderView view = new MediaVolumeSliderView(mContext);
+        assertThat(view.findViewById(R.id.qs_media_volume_slider).isEnabled()).isFalse();
+        ImageButton button = view.findViewById(R.id.qs_media_volume_mute);
+        assertThat(button.isEnabled()).isFalse();
+        button.performClick();
+        verify(mAudioManager, never()).adjustStreamVolume(anyInt(), anyInt(), anyInt());
+    }
+
+    @Test
+    public void restrictionAddedAfterCreation_isCheckedAgainBeforeAdjustingAudio() {
+        MediaVolumeSliderView view = new MediaVolumeSliderView(mContext);
+        when(mUserManager.hasUserRestriction(eq(UserManager.DISALLOW_ADJUST_VOLUME),
+                any(UserHandle.class))).thenReturn(true);
+        ImageButton button = view.findViewById(R.id.qs_media_volume_mute);
+        button.performClick();
+        assertThat(button.isEnabled()).isFalse();
+        verify(mAudioManager, never()).adjustStreamVolume(anyInt(), anyInt(), anyInt());
+    }
+}
