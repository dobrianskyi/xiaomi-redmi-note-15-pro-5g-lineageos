From c8e286bb6002a5ad15ef3c35de46948fbc519e12 Mon Sep 17 00:00:00 2001
From: Oleksii Dobrianskyi <dobriansky777@gmail.com>
Date: Fri, 6 Nov 2026 13:57:55 +0200
Subject: [PATCH] SystemUI: give the media slider its own dimensions and colors

Android 17 removed the legacy brightness slider resources. Preserve the media control geometry and state colors under dedicated names and update its Java resource references.

Change-Id: I3eff92050d7159f69bd2860ad5e027ed0c521edf
---
 .../color/qs_media_volume_slider_overlay.xml  | 22 +++++++++++++++++++
 .../color/qs_media_volume_slider_track.xml    | 19 ++++++++++++++++
 .../media_volume_progress_drawable.xml        | 12 +++++-----
 .../media_volume_progress_full_drawable.xml   | 20 ++++++++---------
 .../res/values/dimens_media_volume.xml        | 13 +++++++++++
 .../systemui/qs/MediaVolumeSliderView.java    |  4 ++--
 6 files changed, 72 insertions(+), 18 deletions(-)
 create mode 100644 packages/SystemUI/res/color/qs_media_volume_slider_overlay.xml
 create mode 100644 packages/SystemUI/res/color/qs_media_volume_slider_track.xml
 create mode 100644 packages/SystemUI/res/values/dimens_media_volume.xml

diff --git a/packages/SystemUI/res/color/qs_media_volume_slider_overlay.xml b/packages/SystemUI/res/color/qs_media_volume_slider_overlay.xml
new file mode 100644
index 000000000..a8abd793b
--- /dev/null
+++ b/packages/SystemUI/res/color/qs_media_volume_slider_overlay.xml
@@ -0,0 +1,22 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  ~ Copyright (C) 2023 The Android Open Source Project
+  ~
