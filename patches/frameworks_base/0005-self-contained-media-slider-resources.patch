diff --git a/packages/SystemUI/res/values/dimens_media_volume.xml b/packages/SystemUI/res/values/dimens_media_volume.xml
new file mode 100644
index 000000000..d60cbb756
--- /dev/null
+++ b/packages/SystemUI/res/values/dimens_media_volume.xml
@@ -0,0 +1,13 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Copyright (C) 2026 The LineageOS Project
+     SPDX-License-Identifier: Apache-2.0 -->
+<resources>
+    <!-- Keep the media control independent of legacy brightness slider resources. -->
+    <dimen name="qs_media_volume_slider_height">48dp</dimen>
+    <dimen name="qs_media_volume_slider_corner_radius">24dp</dimen>
+    <dimen name="qs_media_volume_slider_icon_size">20dp</dimen>
+    <dimen name="qs_media_volume_slider_icon_inset">14dp</dimen>
+    <dimen name="qs_media_volume_slider_track_inset">22dp</dimen>
+    <dimen name="qs_media_volume_slider_track_width">4dp</dimen>
+    <dimen name="qs_media_volume_slider_track_corner_radius">2dp</dimen>
+</resources>
diff --git a/packages/SystemUI/src/com/android/systemui/qs/MediaVolumeSliderView.java b/packages/SystemUI/src/com/android/systemui/qs/MediaVolumeSliderView.java
