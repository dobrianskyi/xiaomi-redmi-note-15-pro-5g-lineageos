 .../LapisCallVolumeController.java            | 78 +++++++++++++++++++
 .../incallservice/VolumeChangeService.java    | 11 +++
 3 files changed, 92 insertions(+)
 create mode 100644 app/InCallService/src/org/lineageos/mediatek/incallservice/LapisCallVolumeController.java

diff --git a/app/InCallService/AndroidManifest.xml b/app/InCallService/AndroidManifest.xml
index cb5c2bc..4262ff6 100644
--- a/app/InCallService/AndroidManifest.xml
+++ b/app/InCallService/AndroidManifest.xml
@@ -5,6 +5,9 @@
     android:versionName="1.0"
     android:sharedUserId="android.uid.system">
 
