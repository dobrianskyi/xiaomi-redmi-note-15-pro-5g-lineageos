From 2692cca868d8a21a2d1818ccf35acafce23ee285 Mon Sep 17 00:00:00 2001
From: Oleksii Dobrianskyi <dobriansky777@gmail.com>
Date: Wed, 16 Sep 2026 18:46:56 +0300
Subject: [PATCH] build: select Lineage charger resources without duplicate
 install rules

---
 base.mk            | 3 +++
 charger/Android.mk | 4 ++++
 2 files changed, 7 insertions(+)

diff --git a/base.mk b/base.mk
index 6e1f5a7..0602482 100644
--- a/base.mk
+++ b/base.mk
@@ -51,9 +51,12 @@ PRODUCT_COPY_FILES += \
 PRODUCT_COPY_FILES += \
     device/phh/treble/charger.rc:system/etc/init/charger.rc
 
+# Lineage GSI already installs its own charger artwork at the same paths.
+ifeq ($(filter lineage_gsi_%,$(TARGET_PRODUCT)),)
 # Charger image
 PRODUCT_PACKAGES += \
     product_charger_res_images
+endif
 
 # USB Audio
 PRODUCT_COPY_FILES += \
diff --git a/charger/Android.mk b/charger/Android.mk
index cc18272..c3b9b02 100644
--- a/charger/Android.mk
+++ b/charger/Android.mk
@@ -15,6 +15,8 @@
 #
 #
 
+ifeq ($(filter lineage_gsi_%,$(TARGET_PRODUCT)),)
+
 LOCAL_PATH := $(call my-dir)
 
 ### pixel_charger_res_images ###
@@ -66,3 +68,5 @@ _add-product-charger-animation-file :=
 _img_modules :=
 _anim_modules :=
 endif # LOCAL_CHARGER_NO_UI
+
+endif # non-Lineage charger artwork
-- 
2.55.0

